# Only what Golden Gate compiles in: Chipyard's firechip bridge interfaces
# and their Golden Gate implementations.
filegroup(
    name = "firechip_goldengate_srcs",
    srcs = glob([
        "generators/firechip/bridgeinterfaces/src/main/scala/**/*.scala",
        "generators/firechip/goldengateimplementations/src/main/scala/**/*.scala",
    ]),
    visibility = ["//visibility:public"],
)
