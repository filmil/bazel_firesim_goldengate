load("@rules_java//java:defs.bzl", "java_binary", "java_import")

load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("//tools:defs.bzl", "relocated_jar")

# Golden Gate as a scala_binary; its `_deploy.jar` is the self-contained jar
# the release ships.
alias(
    name = "goldengate",
    actual = "@firesim//:goldengate",
)

# The release: a module in itself (firesim_goldengate) holding the jar, which
# the registry entry points at.
#
# Its jar is the deploy jar, with its Chisel source locators made
# repo-relative (`sim/midas/...`): the jar then holds no path of the build
# machine, and two builds in different output bases give the same bytes.
relocated_jar(
    name = "release_jar",
    binary = "@firesim//:goldengate",
    jar = "@firesim//:goldengate_deploy.jar",
    out = "goldengate-1.22.0.jar",
    visibility = ["//tools:__pkg__"],
)

pkg_files(
    name = "release_files",
    srcs = [
        ":release_jar",
        "release/release.BUILD",
        "release/release.MODULE",
    ],
    renames = {
        "release/release.BUILD": "BUILD.bazel",
        "release/release.MODULE": "MODULE.bazel",
    },
)

pkg_zip(
    name = "release",
    srcs = [":release_files"],
    out = "firesim_goldengate-1.22.0.zip",
)

# The released jar, run as consumers run it: the smoke run below uses this,
# so it tests the packaged jar and release.BUILD's flags.
java_import(
    name = "release_goldengate_jar",
    jars = [":release_jar"],
)

java_binary(
    name = "release_goldengate",
    main_class = "midas.stage.GoldenGateMain",
    jvm_flags = ["-Xss8M"],
    runtime_deps = [":release_goldengate_jar"],
)

# A smoke run: FireSim's GCD example, elaborated, then through the released
# Golden Gate for Nitefury II. About a minute and a half.
genrule(
    name = "gcd_fir",
    outs = ["gcd/GCD.fir", "gcd/GCD.anno.json"],
    cmd = "$(location @firesim//:examples_generator) " +
          "--target-dir $(RULEDIR)/gcd --name GCD " +
          "--top-module firesim.midasexamples.GCD " +
          "--configs firesim.midasexamples.NoConfig > $(RULEDIR)/gcd.log 2>&1 " +
          "|| { tail -40 $(RULEDIR)/gcd.log >&2; exit 1; }",
    tools = ["@firesim//:examples_generator"],
    tags = ["manual"],
)

genrule(
    name = "gcd_goldengate",
    srcs = ["gcd/GCD.fir", "gcd/GCD.anno.json"],
    outs = ["gg/FireSim-generated.sv", "gg/FireSim-generated.const.h"],
    cmd = "$(location :release_goldengate) " +
          "-i $(location gcd/GCD.fir) -td $(RULEDIR)/gg " +
          "-faf $(location gcd/GCD.anno.json) " +
          "-ggcp firesim.midasexamples -ggcs DefaultNitefuryConfig " +
          "--output-filename-base FireSim-generated " +
          "--allow-unrecognized-annotations --no-dedup > $(RULEDIR)/gg.log 2>&1 " +
          "|| { tail -40 $(RULEDIR)/gg.log >&2; exit 1; }",
    tools = [":release_goldengate"],
    tags = ["manual"],
)
