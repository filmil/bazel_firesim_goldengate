module(
    name = "bazel_firesim_goldengate",
    version = "1.22.0",
)

bazel_dep(name = "rules_scala", version = "7.4.0")
bazel_dep(name = "rules_jvm_external", version = "6.7")
bazel_dep(name = "rules_java", version = "8.14.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "rules_python", version = "0.40.0")


# Golden Gate's own world, as FireSim's sim/build.sbt has it: Chisel 3.6.1.
# FireSim builds on Scala 2.13.10; 2.13.14 is the newest the Chisel 3.6.1
# plugin is published for.
scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(scala_version = "2.13.14")
scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()

# rules_scala 7.4.0 ships 2.13.18; the compiler, library and reflect are
# pointed at 2.13.14 here, as its version check asks.
scala_deps.overridden_artifact(
    name = "io_bazel_rules_scala_scala_compiler",
    artifact = "org.scala-lang:scala-compiler:2.13.14",
    sha256 = "17b7e1dd95900420816a3bc2788c8c7358c2a3c42899765a5c463a46bfa569a6",
    deps = [
        "@io_bazel_rules_scala_scala_library",
        "@io_bazel_rules_scala_scala_reflect",
        "@io_github_java_diff_utils_java_diff_utils",
        "@org_jline_jline",
    ],
)
scala_deps.overridden_artifact(
    name = "io_bazel_rules_scala_scala_library",
    artifact = "org.scala-lang:scala-library:2.13.14",
    sha256 = "43e0ca1583df1966eaf02f0fbddcfb3784b995dd06bfc907209347758ce4b7e3",
)
scala_deps.overridden_artifact(
    name = "io_bazel_rules_scala_scala_reflect",
    artifact = "org.scala-lang:scala-reflect:2.13.14",
    sha256 = "8846baaa8cf43b1b19725ab737abff145ca58d14a4d02e75d71ca8f7ca5f2926",
    deps = ["@io_bazel_rules_scala_scala_library"],
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "gg_maven",
    artifacts = [
        "edu.berkeley.cs:chisel3_2.13:3.6.1",
        "edu.berkeley.cs:chisel3-plugin_2.13.14:3.6.1",
        "org.apache.commons:commons-lang3:3.12.0",
        "org.apache.commons:commons-text:1.9",
        "org.json4s:json4s-native_2.13:3.6.10",
        "org.json4s:json4s-jackson_2.13:4.0.5",
        "com.lihaoyi:sourcecode_2.13:0.3.1",
        "com.lihaoyi:mainargs_2.13:0.5.0",
        "org.scala-graph:graph-core_2.13:1.13.5",
        "org.scala-lang:scala-reflect:2.13.14",
    ],
    lock_file = "//:gg_maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "gg_maven")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

